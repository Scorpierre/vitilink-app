# =============================================================================
# FRONTEND (SvelteKit) — Variables d'environnement locales
# Copier en front/.env pour le développement local
# Les variables VITE_ sont exposées côté client (ne pas y mettre de secrets)
# =============================================================================

# URL de l'API backend
VITE_API_URL=http://localhost:3000

# Clé publique Stripe (mode test) — exposée côté client, ce n'est pas un secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
