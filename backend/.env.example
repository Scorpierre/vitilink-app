# =============================================================================
# BACKEND (NestJS) — Variables d'environnement locales
# Copier en backend/.env pour le développement local
# En Docker, ces valeurs sont injectées via docker-compose
# =============================================================================

# Connexion PostgreSQL locale
DATABASE_URL=postgresql://postgres:changeme@localhost:5434/vitilink?schema=public

# Clé secrète JWT — générer avec : openssl rand -hex 32
JWT_SECRET=change_me_with_a_long_random_string

# Environnement (development | production)
NODE_ENV=development

# Port d'écoute du serveur
PORT=3000

# Origine autorisée pour le CORS (URL du frontend)
CORS_ORIGIN=http://localhost:5173

# Stripe (mode test) — récupérer sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Secret de signature du webhook — fourni par `stripe listen` ou le dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email transactionnel — Mailtrap (test) ou SMTP prod
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=xxx
SMTP_PASS=xxx
MAIL_FROM=VitiLink <noreply@vitilink.app>
