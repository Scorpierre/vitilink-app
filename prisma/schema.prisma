generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER
  BUYER
  BOTH
}

enum CompanyType {
  EARL
  GAEC
  SAS
  SARL
  COOPERATIVE
  NEGOCE
  OTHER
}

enum EntrepriseStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AnnonceStatus {
  DRAFT
  PUBLISHED
  SOLD
  ARCHIVED
}

enum DocumentType {
  USER_DOC
  SALE_DOC
  KBIS
  SIRENE_NOTICE
  VAT_CERTIFICATE
  RIB
  CVI_CERTIFICATE
  IDENTITY_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole @default(BUYER)

  firstName String?
  lastName  String?
  phone     String?

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  annonces      Annonce[]      @relation("AnnonceCreator")
  conversations Conversation[] @relation("ConversationBuyer")
  messages      Message[]
  documents     Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Entreprise {
  id     String           @id @default(uuid())
  name   String
  type   CompanyType
  status EntrepriseStatus @default(PENDING)

  siren     String? @db.VarChar(9)
  siret     String? @db.VarChar(14)
  vatNumber String?
  cviNumber String?

  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String? @default("France")

  region         String?
  department     String?
  appellations   String[]
  grapeVarieties String[]
  surfaceHa      Float?
  annualVolume   Float?
  soughtProducts String[]
  soughtVolume   String?

  verificationNote String?
  verifiedAt       DateTime?

  users     User[]
  annonces  Annonce[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([siren])
  @@index([siret])
}

model Annonce {
  id          String        @id @default(uuid())
  title       String
  productType String?
  description String?
  price       Float?
  volume      Float?
  volumeUnit  String?       @default("hl")
  vintage     Int?
  location    String?
  city        String?
  region      String?
  country     String?       @default("France")
  availabilityTiming String?
  certifications String[]      @default([])
  images      String[]         @default([])
  status      AnnonceStatus @default(DRAFT)

  restrictToVerified Boolean @default(false)

  creatorUserId String
  creator       User @relation("AnnonceCreator", fields: [creatorUserId], references: [id])

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])

  conversations Conversation[]
  documents     Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([creatorUserId])
  @@index([entrepriseId])
  @@index([region])
}

model Conversation {
  id    String  @id @default(uuid())
  isSAV Boolean @default(false)

  annonceId String
  annonce   Annonce @relation(fields: [annonceId], references: [id])

  buyerId String
  buyer   User @relation("ConversationBuyer", fields: [buyerId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([annonceId, buyerId])
}

model Message {
  id      String @id @default(uuid())
  content String

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())
}

model Document {
  id     String         @id @default(uuid())
  url    String
  type   DocumentType
  status DocumentStatus @default(PENDING)

  originalName String?
  mimeType     String?
  sizeBytes    Int?
  label        String?
  comment      String?

  annonceId String?
  annonce   Annonce? @relation(fields: [annonceId], references: [id])

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([entrepriseId])
  @@index([userId])
}
