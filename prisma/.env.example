# =============================================================================
# PRISMA — Variables d'environnement locales
# Copier en prisma/.env pour le développement local
# En Docker, Prisma utilise la DATABASE_URL injectée via docker-compose
# =============================================================================

# Connexion PostgreSQL locale (port 5434 = DB Docker exposée sur l'hôte)
DATABASE_URL=postgresql://postgres:changeme@localhost:5434/vitilink?schema=public
