# =============================================================================
# VITILINK — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vitilink

# -----------------------------------------------------------------------------
# Backend (NestJS) — voir aussi backend/.env.example
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_with_a_long_random_string
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Stripe (paiement — mode test)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email transactionnel — Mailtrap (test) ou SMTP prod
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=xxx
SMTP_PASS=xxx
MAIL_FROM=VitiLink <noreply@vitilink.app>

# -----------------------------------------------------------------------------
# Frontend (SvelteKit) — voir aussi front/.env.example
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
